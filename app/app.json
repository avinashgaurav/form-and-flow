{
  "expo": {
    "name": "Form & Flow",
    "slug": "form-and-flow",
    "scheme": "formandflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.formandflow.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "dev.formandflow.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6E5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Form & Flow",
      "shortName": "Form & Flow",
      "themeColor": "#FFF6E5",
      "backgroundColor": "#FFF6E5"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Form & Flow opens your photos only when you choose a meal photo to log.",
          "cameraPermission": "Form & Flow uses the camera only when you take a photo of a meal to log.",
          "microphonePermission": false
        }
      ],
      "expo-video"
    ],
    "icon": "./assets/icon.png"
  }
}
