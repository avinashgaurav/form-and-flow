{
  "expo": {
    "name": "Form & Flow",
    "slug": "form-and-flow",
    "scheme": "formandflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": false, "bundleIdentifier": "dev.formandflow.app" },
    "android": { "package": "dev.formandflow.app" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-status-bar", "expo-font", "expo-sqlite", "expo-secure-store"]
  }
}
