# Optional. Without these the app runs fully on the phone (no backup, coach answers from rules only).
# Copy to app/.env and fill in from your Supabase project's API settings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional. 1 turns on the AI safety screen in the coach. Leave it off until migration 0006 and the
# safety-screen function are deployed and the live smoke test passes (see supabase/SETUP.md).
EXPO_PUBLIC_SAFETY_SCREEN=0

# Optional. The AI company named in the in-app privacy notice: gemini (Google, the default) or anthropic.
# Must match the server's AI_PROVIDER secret (see supabase/SETUP.md).
EXPO_PUBLIC_AI_PROVIDER=gemini
